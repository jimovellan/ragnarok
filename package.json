  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimovellan/ragnarok.git"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "node-pg-migrate": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@scalar/express-api-reference": "^0.10.12",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pip": "^0.0.1",
    "zod": "^4.4.3"
  }
