{
  "name": "rag-narok",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  
  "bin": {
    "ragnarok": "./dist/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "ts-node src/index.ts",
    "dev": "npm run build && node dist/index.js",
    "migrate": "node scripts/migrate.mjs",
    "migrate:up": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down",
    "migrate:create": "node scripts/migrate.mjs create -j sql",
    "seed": "npm run build && node scripts/seed.mjs",
    "reembed": "npm run build && node scripts/reembed.mjs",
    "eval:search": "npm run build && node scripts/eval-search.mjs"
  },
  "keywords": [],
